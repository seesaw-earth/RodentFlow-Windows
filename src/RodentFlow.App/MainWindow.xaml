<?xml version="1.0" encoding="utf-8"?>
<!--
  No control here is given a Value, SelectedIndex or Text: every value comes from MainViewModel in
  code (MainWindow.Refresh). A preset value raises its changed event inside InitializeComponent,
  before the window is built, which crashed the app at start-up. The same goes for the SelectorBar:
  no item is marked IsSelected here; the window selects the first one once it is built.

  Layout, as the Mac's window: the sidebar (tasks → groups, the cross-task lists), the list of the selected
  task's animals and sessions, and the page of what is selected — a task's overview (TaskPage) or a
  session's steps (SessionPage): Session info, Calibrate (the frame with the arena and the task's markers)
  and Results (ReportPresenter), with the setup on its left and the run bar at its bottom.
-->
<Window
    x:Class="RodentFlow.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="RodentFlow">

    <NavigationView x:Name="Sidebar" PaneDisplayMode="Auto" IsBackButtonVisible="Collapsed"
                    IsSettingsVisible="False" OpenPaneLength="260" PaneTitle="RodentFlow"
                    SelectionChanged="SidebarSelectionChanged">
        <NavigationView.PaneFooter>
            <StackPanel Spacing="6" Padding="12,8,12,12">
                <Button x:Name="NewTaskButton" Content="New task…" Click="NewTask" HorizontalAlignment="Stretch" />
                <Button x:Name="OpenRunButton" Content="Import an analysed folder…" Click="OpenAnalysedFolder"
                        HorizontalAlignment="Stretch" />
            </StackPanel>
        </NavigationView.PaneFooter>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============================ the selected task's animals and sessions ============================ -->
        <Grid Grid.Column="0" x:Name="ListPane" RowSpacing="8" Padding="12,16,12,12"
              BorderThickness="0,0,1,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Spacing="2">
                <TextBlock x:Name="ListTitle" Style="{ThemeResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                <TextBlock x:Name="ListSubtitle" Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.7"
                           TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6">
                <Button x:Name="AddVideosButton" Content="Add videos…" Click="AddVideos" />
                <Button x:Name="AnalyseAllButton" Content="Analyse all ready" Click="AnalyseAll" />
            </StackPanel>
            <ListView Grid.Row="2" x:Name="SessionList" SelectionMode="Single" SelectionChanged="SessionSelected" />
        </Grid>

        <Grid Grid.Column="1" x:Name="DetailPane">
        <!-- ============================ a task: its overview ============================ -->
        <ScrollViewer x:Name="TaskPage" Visibility="Collapsed">
            <StackPanel x:Name="TaskHost" Spacing="14" Padding="24" MaxWidth="1000" HorizontalAlignment="Stretch" />
        </ScrollViewer>

        <!-- ============================ a session: its steps ============================ -->
    <Grid x:Name="SessionPage" ColumnSpacing="20" Padding="20" RowSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================ left: what to analyse ============================ -->
        <ScrollViewer Grid.Row="0" Grid.Column="0">
            <StackPanel Spacing="12" Padding="0,0,14,0">

                <TextBlock x:Name="VideoLabelTitle" Text="Video" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <Button x:Name="PickVideoButton" Content="Locate the video…" Click="PickVideo"
                        HorizontalAlignment="Stretch" Visibility="Collapsed" />
                <TextBlock x:Name="VideoLabel" TextWrapping="Wrap"
                           Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.8" />

                <TextBlock x:Name="TaskLabelTitle" Text="Task" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />
                <ComboBox x:Name="TaskBox" HorizontalAlignment="Stretch"
                          DisplayMemberPath="Title" SelectionChanged="TaskChanged" />
                <TextBlock x:Name="TaskTagline" TextWrapping="Wrap"
                           Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.7" />

                <ComboBox x:Name="PhaseBox" Header="Phase" HorizontalAlignment="Stretch"
                          DisplayMemberPath="Title" SelectionChanged="PhaseChanged" />
                <TextBox x:Name="PhaseText" Header="Phase or condition label (optional)"
                         TextChanged="PhaseTextChanged" />

                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="CoatBox" Grid.Column="0" Header="Coat colour"
                              HorizontalAlignment="Stretch" SelectionChanged="CoatChanged" />
                    <NumberBox x:Name="AnimalsBox" Grid.Column="1" Header="Animals" Width="90"
                               Minimum="1" Maximum="10" SpinButtonPlacementMode="Compact"
                               ValueChanged="AnimalsChanged" />
                </Grid>


                <TextBlock x:Name="ArenaLabelTitle" Text="Arena" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />
                <ComboBox x:Name="ArenaBox" HorizontalAlignment="Stretch" SelectionChanged="ArenaChanged" />

                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <NumberBox x:Name="DimABox" Grid.Column="0" Header="Width, cm"
                               Minimum="0.1" Maximum="1000" ValueChanged="DimensionChanged" />
                    <NumberBox x:Name="DimBBox" Grid.Column="1" Header="Height, cm"
                               Minimum="0.1" Maximum="1000" ValueChanged="DimensionChanged" />
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="FillFrameButton" Content="Fill the frame" Click="FillFrame" />
                    <Button x:Name="ResetPositionsButton" Content="Reset positions" Click="ResetPositions" />
                </StackPanel>
                <Button x:Name="CopySetupButton" Content="Use this setup for all sessions of the task…"
                        Click="CopySetupToTask" HorizontalAlignment="Stretch" />

                <TextBlock x:Name="TaskSettingsTitle" Text="Task settings" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />
                <StackPanel x:Name="TaskFormPanel" Spacing="10" />

                <TextBlock x:Name="AnalysisWindowTitle" Text="Analysis window" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />
                <StackPanel x:Name="CommonFormPanel" Spacing="10" />

                <TextBlock x:Name="RecognitionTitle" Text="Recognition" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <NumberBox x:Name="ToBox" Grid.Column="0" Header="First N seconds (0 = all)"
                               Minimum="0" Maximum="1000000" ValueChanged="RangeChanged" />
                    <NumberBox x:Name="StrideBox" Grid.Column="1" Header="Every Nth frame"
                               Minimum="1" Maximum="60"
                               SpinButtonPlacementMode="Compact" ValueChanged="RangeChanged" />
                </Grid>
                <TextBlock x:Name="RecognitionHelp" Text="What the model is run on. A stride above 1 analyses fewer frames, which is quicker but coarser; every measure uses only the frames that were analysed. The analysis window above only chooses which of the recognised frames are counted."
                           TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.6" />
                <ComboBox x:Name="DeviceBox" Header="Run the model on" HorizontalAlignment="Stretch" SelectionChanged="DeviceChanged">
                    <ComboBoxItem x:Name="DeviceAutoItem" Content="Automatic (the faster, timed once)" Tag="auto" />
                    <ComboBoxItem x:Name="DeviceCpuItem" Content="Processor (CPU)" Tag="cpu" />
                    <ComboBoxItem x:Name="DeviceGpuItem" Content="Graphics card (GPU)" Tag="gpu" />
                </ComboBox>
            </StackPanel>
        </ScrollViewer>

        <!-- ============================ right: Calibrate | Results ============================ -->
        <Grid Grid.Row="0" Grid.Column="1" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <SelectorBar Grid.Row="0" x:Name="StepBar" SelectionChanged="StepChanged">
                <SelectorBarItem x:Name="InfoStep" Text="Session info">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
                <SelectorBarItem x:Name="CalibrateStep" Text="Calibrate">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xE7A8;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
                <SelectorBarItem x:Name="ResultsStep" Text="Results">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xE9D2;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
                <SelectorBarItem x:Name="ReviewStep" Text="Review">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xE714;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
            </SelectorBar>

            <InfoBar Grid.Row="1" x:Name="SetupCheck" Severity="Error" IsClosable="False"
                     Title="Task forms do not match the engine" />
            <InfoBar Grid.Row="2" x:Name="ModelWarning" Severity="Warning" IsClosable="False"
                     Title="Missing models" />

        <!-- ============================ step 1: session info ============================ -->
        <ScrollViewer Grid.Row="3" x:Name="InfoPane" Visibility="Collapsed">
            <StackPanel Spacing="12" MaxWidth="560" HorizontalAlignment="Left" Padding="0,0,16,16">
                <TextBlock x:Name="InfoTitle" Style="{ThemeResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                <TextBlock x:Name="InfoVideoLabel" TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}"
                           Opacity="0.7" IsTextSelectionEnabled="True" />
                <Grid ColumnSpacing="12" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBox Grid.Row="0" Grid.Column="0" x:Name="SubjectBox" Header="Animal ID *"
                             TextChanged="SubjectChanged" />
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="GroupBox" Header="Group"
                             TextChanged="GroupChanged" />
                    <ComboBox Grid.Row="1" Grid.Column="0" x:Name="SexBox" Header="Sex" HorizontalAlignment="Stretch"
                              SelectionChanged="SexChanged">
                        <ComboBoxItem Content="—" Tag="" />
                        <ComboBoxItem Content="M" Tag="M" />
                        <ComboBoxItem Content="F" Tag="F" />
                    </ComboBox>
                    <CalendarDatePicker Grid.Row="1" Grid.Column="1" x:Name="DateBox" Header="Recording date *"
                                        HorizontalAlignment="Stretch" DateChanged="DateChanged" />
                    <NumberBox Grid.Row="2" Grid.Column="0" x:Name="SessionNumberBox" Header="Session # *"
                               Minimum="1" Maximum="9999" SpinButtonPlacementMode="Compact"
                               ValueChanged="SessionNumberChanged" />
                    <Grid Grid.Row="2" Grid.Column="1" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <NumberBox Grid.Column="0" x:Name="DayBox" Header="Day" Minimum="0" Maximum="9999"
                                   ValueChanged="DayTrialChanged" />
                        <NumberBox Grid.Column="1" x:Name="TrialBox" Header="Trial" Minimum="0" Maximum="9999"
                                   ValueChanged="DayTrialChanged" />
                    </Grid>
                </Grid>
                <TextBlock x:Name="InfoProblemsLabel" TextWrapping="Wrap" Foreground="OrangeRed" />
                <TextBox x:Name="NotesBox" Header="Notes" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80"
                         TextChanged="NotesChanged" />
                <ComboBox x:Name="ReviewBox" Header="Tracking check" HorizontalAlignment="Stretch"
                          SelectionChanged="ReviewChanged">
                    <ComboBoxItem x:Name="ReviewUncheckedItem" Content="Not checked yet" Tag="Unreviewed" />
                    <ComboBoxItem x:Name="ReviewOkItem" Content="Checked: the tracking is right" Tag="Accepted" />
                    <ComboBoxItem x:Name="ReviewProblemItem" Content="Checked: the tracking has problems" Tag="Flagged" />
                </ComboBox>
                <CheckBox x:Name="ExcludedBox" Content="Leave this session out of summaries" Click="ExcludedChanged" />
                <TextBox x:Name="ExclusionReasonBox" Header="Why it is left out" TextChanged="ExclusionReasonChanged" />
                <Button x:Name="RemoveSessionButton" Content="Remove this session from the task…" Click="RemoveSession" />
            </StackPanel>
        </ScrollViewer>

        <!-- ============================ step 2: the picture ============================ -->
        <Grid Grid.Row="3" x:Name="CalibratePane" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="2">
                <TextBlock x:Name="PlaceArenaTitle" Text="Place the arena" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <TextBlock x:Name="ArenaHintLabel" TextWrapping="Wrap"
                           Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.75" />
            </StackPanel>

            <!-- The picture and the handles share one coordinate space: FrameHost is sized to the
                 frame's aspect ratio in code, so a point on screen maps straight to 0–1. -->
            <Border Grid.Row="1" x:Name="FrameArea" Background="{ThemeResource LayerFillColorDefaultBrush}"
                    CornerRadius="4" SizeChanged="FrameAreaSizeChanged">
                <Grid x:Name="FrameHost" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image x:Name="FrameImage" Stretch="Fill" />
                    <!-- While the model runs: the frame it just analysed with the tracked animals (the Mac's live view),
                         under the handles and zones, which stay visible. -->
                    <Border x:Name="LiveArea" Visibility="Collapsed" />
                    <Canvas x:Name="Overlay" Background="Transparent"
                            PointerMoved="OverlayPointerMoved"
                            PointerReleased="OverlayPointerReleased"
                            PointerCaptureLost="OverlayPointerReleased" />
                </Grid>
            </Border>

            <StackPanel Grid.Row="2" Spacing="4">
                <TextBlock x:Name="MarkerLegendLabel" TextWrapping="Wrap"
                           Style="{ThemeResource CaptionTextBlockStyle}" />
                <TextBlock x:Name="ScaleLabel" Style="{ThemeResource CaptionTextBlockStyle}" />
                <TextBlock x:Name="PlanLabel" Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.6" />
            </StackPanel>
        </Grid>

        <!-- ============================ step 4: frame-by-frame review ============================ -->
        <Grid Grid.Row="3" x:Name="ReviewPane" Visibility="Collapsed" RowSpacing="8" KeyDown="ReviewKeyDown">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" x:Name="ReviewVideoArea" Background="Black" CornerRadius="6" MinHeight="200" />
            <TextBlock Grid.Row="1" x:Name="ReviewReadout" Style="{ThemeResource CaptionTextBlockStyle}"
                       TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            <Border Grid.Row="2" x:Name="ReviewTimelineHost" />
            <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="6">
                <Button x:Name="ReviewPrevEventButton" Click="ReviewPrevEvent">
                    <FontIcon Glyph="&#xE892;" FontSize="14" />
                </Button>
                <Button x:Name="ReviewStepBackButton" Click="ReviewStepBack">
                    <FontIcon Glyph="&#xE76B;" FontSize="14" />
                </Button>
                <Button x:Name="ReviewPlayButton" Click="ReviewPlay" Style="{ThemeResource AccentButtonStyle}" MinWidth="48">
                    <FontIcon x:Name="ReviewPlayIcon" Glyph="&#xE768;" FontSize="14" />
                </Button>
                <Button x:Name="ReviewStepForwardButton" Click="ReviewStepForward">
                    <FontIcon Glyph="&#xE76C;" FontSize="14" />
                </Button>
                <Button x:Name="ReviewNextEventButton" Click="ReviewNextEvent">
                    <FontIcon Glyph="&#xE893;" FontSize="14" />
                </Button>
                <ComboBox x:Name="ReviewSpeedBox" SelectionChanged="ReviewSpeedChanged" MinWidth="80">
                    <ComboBoxItem Content="0.25×" Tag="0.25" />
                    <ComboBoxItem Content="0.5×" Tag="0.5" />
                    <ComboBoxItem Content="1×" Tag="1" />
                    <ComboBoxItem Content="2×" Tag="2" />
                    <ComboBoxItem Content="4×" Tag="4" />
                </ComboBox>
                <ComboBox x:Name="ReviewEventBox" SelectionChanged="ReviewEventFilterChanged" MinWidth="170" />
                <CheckBox x:Name="ReviewTrailBox" Content="Trail" Click="ReviewOptionsChanged" MinWidth="0" />
                <CheckBox x:Name="ReviewZonesBox" Content="Zones" Click="ReviewOptionsChanged" MinWidth="0" />
            </StackPanel>
            <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8">
                <StackPanel x:Name="IdentityTools" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SwapFromHereButton" Content="Swap A / B from this frame" Click="SwapFromHere" />
                    <Button x:Name="MarkRangeButton" Content="Mark range start" Click="MarkRangeStart" />
                    <Button x:Name="SwapRangeButton" Content="Swap A / B from the mark to here" Click="SwapRange" />
                </StackPanel>
                <Button x:Name="TrackingOkButton" Content="The tracking is right" Click="MarkTrackingOk" />
                <Button x:Name="TrackingProblemButton" Content="The tracking has problems" Click="MarkTrackingProblem" />
            </StackPanel>
            <StackPanel Grid.Row="5" x:Name="FeedingTools" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                <TextBlock x:Name="FeedingStatus" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="360" />
                <ComboBox x:Name="FeedingCandidatesBox" SelectionChanged="FeedingCandidateChosen" MinWidth="170" />
                <Button x:Name="SetFirstBiteButton" Content="Set as first bite" Click="SetFirstBite" />
                <Button x:Name="NoFeedingButton" Content="No feeding before the cut-off" Click="SetNoFeeding" />
                <Button x:Name="ClearFeedingButton" Content="Clear" Click="ClearFeeding" />
            </StackPanel>
        </Grid>

        <!-- ============================ step 3: the result page ============================ -->
        <Grid Grid.Row="3" x:Name="ResultsPane" RowSpacing="10" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="AnnotateButton" Content="Make a review video"
                        Click="MakeReviewVideo" IsEnabled="False" />
                <Button Grid.Column="1" x:Name="OpenResults" Content="Open the result folder"
                        Click="OpenResultFolder" IsEnabled="False" />
                <TextBlock Grid.Column="2" x:Name="ResultsStateLabel" VerticalAlignment="Center"
                           TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.75" />
                <ComboBox Grid.Column="3" x:Name="LanguageBox" MinWidth="130"
                          SelectionChanged="LanguageChanged">
                    <ComboBoxItem Content="English" Tag="en" />
                    <ComboBoxItem Content="中文" Tag="zh" />
                </ComboBox>
            </Grid>
            <ScrollViewer Grid.Row="1" x:Name="ResultsScroll" CornerRadius="8"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <Grid Padding="16">
                    <StackPanel x:Name="ResultsHost" Spacing="14" MaxWidth="1100" HorizontalAlignment="Stretch" />
                    <TextBlock x:Name="ResultsEmpty" TextWrapping="Wrap" MaxWidth="520" Margin="0,40,0,0"
                               HorizontalAlignment="Center" TextAlignment="Center" Opacity="0.7" />
                </Grid>
            </ScrollViewer>
        </Grid>
        </Grid>

        <!-- ============================ bottom: run ============================ -->
        <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="StartButton" Content="Analyse" Click="Start"
                    Style="{ThemeResource AccentButtonStyle}" MinWidth="120" />
            <Button Grid.Column="1" x:Name="StopButton" Content="Stop" Click="Stop" IsEnabled="False" />
            <Button Grid.Column="2" x:Name="UpdateButton" Content="Update results" Click="UpdateResults"
                    IsEnabled="False" />
            <StackPanel Grid.Column="3" Spacing="4" VerticalAlignment="Center">
                <ProgressBar x:Name="RunProgress" Minimum="0" Maximum="100" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="StatusLabel" TextWrapping="Wrap"
                               Style="{ThemeResource CaptionTextBlockStyle}" />
                    <TextBlock Grid.Column="1" x:Name="EngineLabel"
                               Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.5" />
                </Grid>
            </StackPanel>
        </Grid>
    </Grid>
        </Grid>
    </Grid>
    </NavigationView>
</Window>
