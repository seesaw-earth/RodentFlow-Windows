<Project Sdk="Microsoft.NET.Sdk">

  <!--
    RodentFlow.Engine — the managed side of RodentFlowABI.dll (the RodentFlow shared engine).
    No NuGet dependencies: System.Text.Json is part of the .NET 8 shared framework.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>RodentFlow.Engine</AssemblyName>
    <RootNamespace>RodentFlow.Engine</RootNamespace>
  </PropertyGroup>

</Project>
